# Exclude large raw datasets from Vercel deployment (saves ~430 MB)
# The pre-trained weights are fully embedded inside models/best_animal_model.tflite
animal_datasets/

# Exclude heavy Keras weights from bundle (LiteRT .tflite is used for serverless inference)
models/*.keras
models/temp_training_model.keras

